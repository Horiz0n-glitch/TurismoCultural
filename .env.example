# Contact form (Resend)
# https://resend.com/api-keys
RESEND_API_KEY=

# Mail destinatario (a dónde llegan los mensajes del formulario)
CONTACT_EMAIL_TO=info@turismocultural.com.ar

# Remitente. Si turismocultural.com.ar está verificado en Resend,
# usar: "Turismo Cultural <info@turismocultural.com.ar>".
# Si NO está verificado, usar el remitente sandbox de Resend:
# "Turismo Cultural <onresend@resend.dev>"
CONTACT_EMAIL_FROM=Turismo Cultural <onresend@resend.dev>